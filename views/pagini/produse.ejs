<DOCTYPE html>
    <html lang="ro" data-bs-theme="dark">

    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="keywords"
            content="FNAF, BOON, BOON:The FNAF Store, magazin, Chika, Bonie, Foxy, Freddy, costume, hanorace, tricouri, pantaloni, huse de telefon, stickere, seturi DIY, Five Nights at Freddy's, FNAF 1" />

        <title>BOON: The FNAF Store - Produse</title>
        <%- include('../fragmente/head.ejs') %>
            <link rel="stylesheet" type="text/css" href="/resurse/css/produse.css" />
            <link rel="stylesheet" type="text/css" href="/resurse/css/efecte.css" />
    </head>

    <body>
        <header>
            <%- include('../fragmente/header.ejs') %>
        </header>

        <main>
            <h2>Magazin</h2>

            <%- include('../fragmente/filtre.ejs') %>

            <section id="container-produse">
                <% for (let produs of produse) { %>
                    <% 
                        let personaje = [];
                        if (produs.personaje_asociate) {
                            for (let p of produs.personaje_asociate) {
                                if (p) personaje.push(p);
                            }
                        }
                        let personajeStr = personaje.length > 0 ? personaje.join(', ') : '-';

                        let dataStr = 'Nelimitat';
                        let isoDate = '';
                        if (produs.disponibil_online_pana) {
                            const zileSapt = ['Duminică','Luni','Marți','Miercuri','Joi','Vineri','Sâmbătă'];
                            const luniAn = ['Ianuarie','Februarie','Martie','Aprilie','Mai','Iunie','Iulie','August','Septembrie','Octombrie','Noiembrie','Decembrie'];
                            let d = new Date(produs.disponibil_online_pana);
                            let zi = d.getDate();
                            let ziSapt = zileSapt[d.getDay()];
                            let luna = luniAn[d.getMonth()];
                            let an = d.getFullYear();
                            let isoMonth = String(d.getMonth()+1).padStart(2,'0');
                            let isoDay = String(d.getDate()).padStart(2,'0');
                            isoDate = an + '-' + isoMonth + '-' + isoDay;
                            dataStr = zi + '(' + ziSapt + ')/' + luna + '/' + an;
                        }

                        let pretFinal = produs.pret;
                        if (produs.reducere_pct) {
                            pretFinal = (produs.pret * (1 - produs.reducere_pct / 100)).toFixed(2);
                        }
                    %>
                    <article class="produs <%= produs.categorie %>" id="ent<%= produs.id %>"
                        data-categorie="<%= produs.categorie %>"
                        data-subcategorie="<%= produs.subcategorie || '' %>"
                        data-joc="<%= produs.joc_sursa || '' %>"
                        data-expediere="<%= produs.expediere || '' %>"
                        data-personaje="<%= personaje.join('|') %>"
                        data-nr-personaje="<%= personaje.length %>">
                        <h3><span class="val-nume"><%= produs.nume %></span><%= produs.este_set ? ' (SET)' : '' %></h3>
                        <div class="produs-detalii">
                            <table class="produs-tabel">
                                <thead>
                                    <th>Pret</th>
                                    <th>Joc</th>
                                    <th>Personaje</th>
                                    <th>Poate fi gasit in magazin pana la data de</th>
                                    <th>Set</th>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><span class="val-pret"><%= produs.pret %></span> RON</td>
                                        <td><%= produs.joc_sursa || '-' %></td>
                                        <td><%= personajeStr %></td>
                                        <td><% if (isoDate) { %><time datetime="<%= isoDate %>"><%= dataStr %></time><% } else { %>Nelimitat<% } %></td>
                                        <td><%= produs.este_set %></td>
                                    </tr>
                                </tbody>
                                <caption class="descriere val-descriere"><%= produs.descriere %></caption>
                            </table>
                            <img src="<%= produs.imagine_cale %>" alt="imagine">
                        </div>
                        <div class="categorie">
                            <p>CATEGORIE: <span class="val-categorie"><%= produs.categorie %></span></p>
                            <% if (produs.subcategorie) { %>
                                <p>SUBCATEGORIE: <%= produs.subcategorie %></p>
                            <% } %>
                            <% if (produs.reducere_pct) { %>
                                <p>OFERTA: <strike><%= produs.pret %> RON</strike> -> <%= pretFinal %> RON</p>
                            <% } %>
                        </div>
                        <a href="/produse/produs/<%= produs.id %>"> </a>
                    </article>
                <% } %>
            </section>
        </main>

        <footer>
            <%- include('../fragmente/footer.ejs') %>
        </footer>

        <script src="/resurse/js/filtre.js"></script>
    </body>

    </html>