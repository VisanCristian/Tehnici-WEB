<h1>BOON:The FNAF Shop</h1>
<nav>
  <label id="hamburger" for="ch-menu">
    <img src="/resurse/imagini/favicon/favicon-96x96.png" alt="BOON sigla" />
  </label>
  <input type="checkbox" id="ch-menu" />
  <ul class="meniu">
    <li>
      <div class="text-icon" id="acasa">Acasa</div>
      <div class="imag-icon" id="acasa-mediu">
        <span class="fas fa-regular fa-house"></span>
      </div>
      <ul>
        <li><a href="/index#welcome">Bine ati venit</a></li>
        <li><a href="/index#promotii">Promotii</a></li>
        <li><a href="/index#anunturi">Anunturi</a></li>
        <li><a href="/index#produse">Produse</a></li>
        <li><a href="/index#orar">Orar</a></li>
        <li><a href="/index#faq">FAQ</a></li>
        <li><a href="/index#fan-related">Fan-Related</a></li>
        <li><a href="/index#video-ytb">Video-uri YTB</a></li>
      </ul>
    </li>
    <li>
      <div class="text-icon" id="magazin">
        <a href="/produse">Produse</a>
      </div>
      <div class="imag-icon" id="magazin-mediu">
        <span class="fas fa-solid fa-store"></span>
      </div>
      <ul>
        <% if (locals.categoriiNav && locals.categoriiNav.length > 0) { %>
          <% for (let cat of locals.categoriiNav) { %>
            <li><a href="/produse?categorie=<%= cat %>"><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></a></li>
          <% } %>
        <% } %>
      </ul>
    </li>
    <li>
      <div class="text-icon">
        <a href="/contact">Contact</a>
      </div>
      <div class="imag-icon">
        <span class="fas fa-solid fa-headset"></span>
      </div>
    </li>
    <li>
      <div class="text-icon" id="faq">
        <a href="#faq">FAQ</a>
      </div>
      <div class="imag-icon" id="faq-mediu">
        <span class="fa-regular fa-envelope"></span>
      </div>
    </li>
  </ul>
  <button id="btn-tema" type="button" title="Schimba tema">
    <i id="icon-tema" class="fa-solid fa-moon"></i>
  </button>
</nav>